# CHEENA OS live image build configuration (Phase 1a).
# Sourced by build/scripts/build-iso.sh. Plain KEY=value only, no secrets.

CHEENA_VERSION="0.1.0-dev"
CHEENA_CODENAME="phase1a"

# Upstream base (ADR-001, provisional): Ubuntu 26.04 LTS "Resolute Raccoon".
UBUNTU_RELEASE="resolute"
ARCH="amd64"
COMPONENTS="main,universe"

# Pinned archive snapshot, for reproducibility (snapshot.ubuntu.com).
# Format YYYYMMDDTHHMMSSZ. Change deliberately and record the change in the PR.
ARCHIVE_SNAPSHOT="20261101T000000Z"
ARCHIVE_URL="https://snapshot.ubuntu.com/ubuntu/${ARCHIVE_SNAPSHOT}"

# Fixed timestamp for reproducible file times in squashfs and ISO:
# 2026-11-01T00:00:00Z
SOURCE_DATE_EPOCH="1793491200"

ISO_VOLUME_ID="CHEENA_0_1_DEV"
SQUASHFS_COMP="zstd"
SQUASHFS_LEVEL="15"
